# Entorno: development | production
NODE_ENV=development
PORT=4000

# PostgreSQL. Para desarrollo, el de docker-compose.yml (npm run services:up desde la raíz).
DATABASE_URL=postgres://study_planner:study_planner_dev@localhost:5432/study_planner
# DATABASE_POOL_SIZE=10

# Varias máquinas (opcional): Redis y almacenamiento compatible con S3. Los de docker-compose.yml:
# REDIS_URL=redis://localhost:6379
# S3_BUCKET=study-planner
# S3_ENDPOINT=http://localhost:8333
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=study-planner-dev
# S3_SECRET_ACCESS_KEY=study-planner-dev-secret
# S3_CREATE_BUCKET=true

# Secreto para firmar las sesiones. Mínimo 32 caracteres aleatorios.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
SESSION_DAYS=7

# Orígenes permitidos para CORS (separados por comas)
CLIENT_ORIGIN=http://localhost:5173

# Cookies de sesión. En despliegues con frontend y backend en dominios distintos usa
# COOKIE_SAMESITE=none y COOKIE_SECURE=true (requiere HTTPS).
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true

# Detrás de un proxy (Render, Railway, Nginx…) pon el número de saltos de proxy
TRUST_PROXY=0

# Límites de peticiones cada 15 minutos (por usuario con sesión, por IP sin sesión, intentos
# fallidos de login por cuenta y por IP)
# RATE_LIMIT_API=1500
# RATE_LIMIT_ANONYMOUS=1500
# RATE_LIMIT_AUTH=25
# RATE_LIMIT_AUTH_IP=500

# Rendimiento: consultas SQL que se registran como lentas (ms) y compresión en Node
# (false si un proxy o CDN ya comprime)
# SLOW_QUERY_MS=20
# COMPRESSION=true

# Procesos de la API: un número o "auto" (uno por núcleo). 1 = sin cluster.
# WORKERS=1

# Archivos
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
MAX_AVATAR_SIZE_MB=8

# Servir el frontend compilado desde Express (despliegue en un único servicio)
SERVE_CLIENT=false
CLIENT_DIST=../client/dist
