{
  "name": "study-planner-server",
  "version": "1.0.0",
  "private": true,
  "description": "API REST y tiempo real de STUDY-PLANNER (Express + PostgreSQL + Socket.IO)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/dev-seed.js",
    "seed:clear": "node src/seed/dev-seed.js --clear",
    "seed:load": "node src/seed/load-seed.js",
    "db:import-sqlite": "node src/database/import-sqlite.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@express-rate-limit/cluster-memory-store": "^0.3.1",
    "@socket.io/cluster-adapter": "^0.3.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "rate-limit-redis": "^4.3.1",
    "redis": "^6.2.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "better-sqlite3": "^12.11.1"
  }
}
