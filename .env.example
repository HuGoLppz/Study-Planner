# Ajustes de la app en Docker (docker compose up). Copia este archivo como .env en la raíz del
# proyecto. Para `npm run dev` se usa server/.env, no este.

# Secreto para firmar las sesiones. Mínimo 32 caracteres aleatorios.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres

# Puerto de tu máquina donde se abre la app. Si lo cambias, cambia también APP_ORIGIN.
# APP_PORT=4000
# APP_ORIGIN=http://localhost:4000

# Detrás de un proxy con HTTPS (Caddy, Nginx…): cookies Secure y número de saltos de proxy.
# COOKIE_SECURE=true
# TRUST_PROXY=1

# Entrar con Google o Apple (opcional): identificadores de cliente, ver README.
# GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
# APPLE_CLIENT_ID=com.tu-dominio.study-planner

# Procesos de la API: un número o "auto" (uno por núcleo).
# WORKERS=1
