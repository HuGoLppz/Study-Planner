# URL base de la API. Con el proxy de Vite (desarrollo) o con Express sirviendo el frontend,
# deja el valor por defecto "/api".
VITE_API_URL=/api

# Origen del servidor Socket.IO. Vacío = mismo origen que la página.
VITE_SOCKET_URL=

# Solo desarrollo: a dónde reenvía Vite /api y /socket.io
VITE_DEV_API_TARGET=http://localhost:4000
